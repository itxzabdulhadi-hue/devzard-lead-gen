# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# In development the Vite dev server proxies /api, so this can stay empty.
WEB_ORIGIN=

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Seed admin account (created by `npm run db:seed`, idempotent).
DEVZARD_ADMIN_EMAIL=admin@devzard.internal
DEVZARD_ADMIN_PASSWORD=devzard-admin

# ── Database ──────────────────────────────────────────────────────────────────
# Default dev setup uses an embedded Postgres managed by `npm run dev`.
DATABASE_URL=postgresql://devzard:devzard@localhost:5433/devzard
# Set to false to manage your own Postgres (DATABASE_URL is then used as-is).
DEVZARD_EMBEDDED_DB=true
# Embedded Postgres settings (only used when DEVZARD_EMBEDDED_DB=true)
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_DIR=.localdb/pgdata

# ── Data sources ──────────────────────────────────────────────────────────────
# Overture Maps release root (S3 or local path prefix). The provider queries
# `<root>/THEMES/places.parquet` with DuckDB. Example:
# OVERTURE_DATA_URL=https://overturemaps-us-west-2.s3.amazonaws.com/release/2025-06-25.0/
OVERTURE_DATA_URL=
# Minimum place confidence (0–1) accepted when importing from Overture.
OVERTURE_MIN_CONFIDENCE=0.6
# Hard cap on records imported per request.
IMPORT_MAX_RECORDS=1000

# ── Website analysis worker ───────────────────────────────────────────────────
ANALYSIS_CONCURRENCY=5
ANALYSIS_TIMEOUT_MS=10000
# Pause between two analyzed websites (politeness delay).
ANALYSIS_DELAY_MS=250
# Minimum delay between two requests to the same host, per worker.
ANALYSIS_PER_HOST_DELAY_MS=1000
# Retries for failed website requests (total attempts = retries + 1).
ANALYSIS_MAX_RETRIES=1
# Maximum number of businesses per bulk-analysis job.
ANALYSIS_MAX_BATCH=2000
# Maximum bytes downloaded per page (safety cap, default 2 MB).
ANALYSIS_MAX_RESPONSE_BYTES=2000000
# DEV/TEST ONLY: allow analysis of private/localhost hosts (needed to analyze
# the bundled demo-sites server without internet access). NEVER enable in prod.
ANALYSIS_ALLOW_PRIVATE_HOSTS=false

# ── Demo sites server (bundled fake business websites for offline testing) ────
DEMO_SITES_PORT=4573
